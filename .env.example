# Copy to .env and fill in. Never commit .env.

# --- Postgres (one server, three databases) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port; 5433 because a local PostgreSQL already uses 5432
POSTGRES_HOST_PORT=5433
POSTGRES_SUPERUSER_PASSWORD=
AIRFLOW_DB_PASSWORD=
PIPELINE_DB_PASSWORD=
AGENT_RO_PASSWORD=
AGENT_RW_PASSWORD=
AGENT_APP_PASSWORD=

# --- Airflow (standalone) ---
AIRFLOW_API_URL=http://airflow:8080
AIRFLOW_USER=admin
# Generated on first start: see airflow/config/simple_auth_manager_passwords.json
AIRFLOW_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=

# --- Intake ---
INCIDENT_WEBHOOK_URL=http://api:8000/incidents
REDIS_URL=redis://redis:6379/0

# --- Weather proxy ---
WEATHER_PROXY_URL=http://weather-proxy:8090
# Host-side port; 8091 because another app already uses 8090
WEATHER_PROXY_HOST_PORT=8091
WEATHER_PROXY_CONTROL_TOKEN=

# --- LLM via OpenRouter (OpenAI-compatible API) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PRIMARY_MODEL=anthropic/claude-haiku-5.5
FALLBACK_MODEL=deepseek/deepseek-v4-flash

# --- Langfuse (optional; leave empty to disable tracing) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU region; use https://us.cloud.langfuse.com for US
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Budgets and evaluation ---
MAX_STEPS=25
MAX_COST_EUR_PER_INCIDENT=0.20
CHAOS_MODE=off
ENV=dev
